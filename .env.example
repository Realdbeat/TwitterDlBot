# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Bot Administrator Telegram ID (Optional - receives error reports or admin notifications)
ADMIN_CHAT_ID=""

# Temporary download directory for video buffers (defaults to sys temp or ./tmp)
TEMP_DIR="./tmp"

# Maximum video size allowed to upload via Telegram Bot API (in MB, Telegram limit is 50MB for bots)
MAX_FILE_SIZE_MB=50

# Request Timeout (seconds)
HTTP_TIMEOUT=160

# Webhook Configuration (only used if running webhook.php)
WEBHOOK_URL="https://xdlbot.mossubyte.com.ng/webhook.php"
WEBHOOK_SECRET=""
# Path to plain-text webhook requests log file (records client IP, address/URL, headers, payload)
WEBHOOK_LOG_FILE="webhook_requests.txt"

# Web Log Monitor Dashboard Password (Optional: secure log.php access)
LOG_PASSWORD=""

# Monetag Rewarded Interstitial SDK (for Telegram Mini App)
# Enable or disable ad requirement before video delivery (true/false)
MONETAG_ENABLED="true"
# Your Monetag Zone ID for Rewarded Interstitial (e.g. 1234567)
MONETAG_ZONE_ID=""
# Optional: Custom Monetag SDK URL (provided in your Monetag dashboard tag)
# If empty, defaults to standard Monetag tag: https://alwingulla.com/88/tag.min.js
MONETAG_SDK_URL=""
# Optional: Base URL of your Mini App (e.g. https://xdlbot.mossubyte.com.ng)
# If left empty, it will be automatically derived from WEBHOOK_URL or server host
MINI_APP_URL=""
